# 環境変数のサンプルファイル
# 実際の値は .env ファイルに設定してください

# 開発/本番環境の設定
NODE_ENV=development

# セキュリティ設定
VITE_ENABLE_SECURITY_LOGGING=true
VITE_CSP_REPORT_URI=
VITE_ENABLE_HTTPS=false

# MediaPipe設定
VITE_MEDIAPIPE_CDN_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@latest/wasm
VITE_MEDIAPIPE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task

# ファイルアップロード制限
VITE_MAX_FILE_SIZE_MB=100
VITE_MIN_FILE_SIZE_KB=1

# ログ設定
VITE_LOG_LEVEL=info
VITE_MAX_LOG_ENTRIES=1000

# 警告: 本番環境では以下の設定を必ず変更してください
# - NODE_ENV=production
# - VITE_ENABLE_HTTPS=true
# - VITE_CSP_REPORT_URI を適切なエンドポイントに設定